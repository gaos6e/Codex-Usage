{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chronolume",
  "mainBinaryName": "chronolume",
  "version": "2.1.5",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chronolume",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../LICENSE", "../THIRD_PARTY_LICENSES.txt"],
    "category": "Utility",
    "shortDescription": "Illuminate your local Codex activity",
    "longDescription": "Private, high-performance and offline-first insight into local OpenAI Codex activity, usage and cost.",
    "copyright": "Copyright © 2026 gaos6e"
  }
}
