{
  "name": "chronolume",
  "productName": "Chronolume",
  "version": "2.1.0",
  "description": "Private, offline-first insight into local Codex activity, usage, and cost.",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run tauri:build:windows",
    "tauri:build:windows": "tauri build --config src-tauri/tauri.windows.conf.json",
    "tauri:build:macos": "tauri build --target universal-apple-darwin --config src-tauri/tauri.macos.conf.json",
    "lint": "eslint --ext .ts,.tsx ui vite.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:versions": "node scripts/check-version-consistency.mjs"
  },
  "keywords": [
    "codex",
    "usage",
    "tauri",
    "windows",
    "macos"
  ],
  "author": {
    "name": "gaos6e",
    "email": "gaoshuai6e@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.9",
    "recharts": "^3.9.2"
  }
}
